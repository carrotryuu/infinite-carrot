# 本地应用配置；Compose 自动使用容器内数据库、Redis 和 NAS 地址。
COMPOSE_FILE=deploy/docker-compose.yml
COMPOSE_PROJECT_NAME=infinite-carrot
NODE_ENV=development
MOCK_EXTERNAL=1
PORT=3000
WEB_PORT=80
POSTGRES_DB=carrot
POSTGRES_USER=carrot
POSTGRES_PASSWORD=carrot-local-only
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://carrot:carrot-local-only@127.0.0.1:5432/carrot
REDIS_URL=redis://127.0.0.1:6379
# 必须改成现有的绝对目录；Windows 示例 D:/infinite-carrot/.data/nas。
NAS_ROOT=/srv/infinite-carrot/nas
HEALTH_TIMEOUT_MS=2000
