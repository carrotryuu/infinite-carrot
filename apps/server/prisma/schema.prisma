generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationTaskStatus {
  queued
  running
  succeeded
  failed
  canceled
}

model GenerationTask {
  id                  String               @id @default(uuid()) @db.Uuid
  teamId              String               @map("team_id") @db.Uuid
  tenantId            String?              @map("tenant_id") @db.Uuid
  idempotencyKey      String               @map("idempotency_key") @db.VarChar(120)
  requestHash         String               @map("request_hash") @db.VarChar(64)
  provider            String               @db.VarChar(32)
  prompt              String
  status              GenerationTaskStatus @default(queued)
  providerTaskId      String?              @map("provider_task_id")
  submissionStartedAt DateTime?            @map("submission_started_at") @db.Timestamptz(3)
  submissionToken     String?              @map("submission_token") @db.Uuid
  cancelRequested     Boolean              @default(false) @map("cancel_requested")
  progress            Int                  @default(0)
  resultUrl           String?              @map("result_url")
  errorCode           String?              @map("error_code") @db.VarChar(100)
  version             Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([teamId, idempotencyKey])
  @@index([teamId, tenantId, status, createdAt])
  @@map("generation_tasks")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actor      String
  action     String
  objectType String   @map("object_type")
  objectId   String   @map("object_id") @db.Uuid
  before     Json?
  after      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([teamId, tenantId, objectId, createdAt])
  @@map("audit_logs")
}

enum UserStatus {
  active
  disabled
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  teamId         String     @map("team_id") @db.Uuid
  tenantId       String?    @map("tenant_id") @db.Uuid
  unionId        String     @unique @map("union_id") @db.VarChar(255)
  name           String     @db.VarChar(200)
  avatarUrl      String?    @map("avatar_url")
  status         UserStatus @default(active)
  assigned       Boolean    @default(false)
  sessionVersion Int        @default(0) @map("session_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@index([teamId, tenantId, status])
  @@map("users")
}
