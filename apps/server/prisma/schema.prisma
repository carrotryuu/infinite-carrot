generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationTaskStatus {
  queued
  running
  succeeded
  failed
  canceled
}

model GenerationTask {
  id                  String               @id @default(uuid()) @db.Uuid
  teamId              String               @map("team_id") @db.Uuid
  tenantId            String?              @map("tenant_id") @db.Uuid
  idempotencyKey      String               @map("idempotency_key") @db.VarChar(120)
  requestHash         String               @map("request_hash") @db.VarChar(64)
  provider            String               @db.VarChar(32)
  prompt              String
  status              GenerationTaskStatus @default(queued)
  providerTaskId      String?              @map("provider_task_id")
  submissionStartedAt DateTime?            @map("submission_started_at") @db.Timestamptz(3)
  submissionToken     String?              @map("submission_token") @db.Uuid
  cancelRequested     Boolean              @default(false) @map("cancel_requested")
  progress            Int                  @default(0)
  resultUrl           String?              @map("result_url")
  errorCode           String?              @map("error_code") @db.VarChar(100)
  version             Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@unique([teamId, idempotencyKey])
  @@index([teamId, tenantId, status, createdAt])
  @@map("generation_tasks")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actor      String
  action     String
  objectType String   @map("object_type")
  objectId   String   @map("object_id") @db.Uuid
  before     Json?
  after      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([teamId, tenantId, objectId, createdAt])
  @@map("audit_logs")
}

enum UserStatus {
  active
  disabled
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  teamId         String     @map("team_id") @db.Uuid
  tenantId       String?    @map("tenant_id") @db.Uuid
  unionId        String     @unique @map("union_id") @db.VarChar(255)
  name           String     @db.VarChar(200)
  avatarUrl      String?    @map("avatar_url")
  status         UserStatus @default(active)
  assigned       Boolean    @default(false)
  sessionVersion Int        @default(0) @map("session_version")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships    Membership[]
  @@index([teamId, tenantId, status])
  @@map("users")
}

model Team {
  id          String @id @default(uuid()) @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid
  name        String @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  projects    Project[]
  memberships Membership[]
  @@map("teams")
}
model Project {
  id          String @id @default(uuid()) @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid
  name        String @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  team        Team @relation(fields: [teamId], references: [id])
  memberships Membership[]
  @@unique([teamId, id])
  @@index([teamId, tenantId])
  @@map("projects")
}
model Role {
  id          String @id @default(uuid()) @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  tenantId    String? @map("tenant_id") @db.Uuid
  key         String @unique @db.VarChar(30)
  name        String @db.VarChar(50)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  permissions RolePermission[]
  memberships Membership[]
  @@map("roles")
}
model PermissionDefinition {
  id       String @id @default(uuid()) @db.Uuid
  teamId   String @map("team_id") @db.Uuid
  tenantId String? @map("tenant_id") @db.Uuid
  point    String @unique @db.VarChar(60)
  roles    RolePermission[]
  @@map("permissions")
}
model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  teamId       String @map("team_id") @db.Uuid
  tenantId     String? @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  role         Role @relation(fields: [roleId], references: [id])
  permission   PermissionDefinition @relation(fields: [permissionId], references: [id])
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
model Membership {
  id        String @id @default(uuid()) @db.Uuid
  teamId    String @map("team_id") @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  scopeKey  String @map("scope_key") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id])
  team      Team @relation(fields: [teamId], references: [id])
  project   Project? @relation(fields: [teamId, projectId], references: [teamId, id])
  role      Role @relation(fields: [roleId], references: [id])
  @@unique([userId, teamId, scopeKey])
  @@index([teamId, tenantId, projectId])
  @@map("memberships")
}
