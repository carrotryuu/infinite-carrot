{
  "name": "@carrot/server",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./gateway/runtime": {
      "types": "./dist/gateway/runtime.d.ts",
      "default": "./dist/gateway/runtime.js"
    },
    "./gateway/config": {
      "types": "./dist/gateway/config.d.ts",
      "default": "./dist/gateway/config.js"
    }
  },
  "typesVersions": {
    "*": {
      "gateway/runtime": [
        "dist/gateway/runtime.d.ts"
      ],
      "gateway/config": [
        "dist/gateway/config.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carrot/shared": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.19.0",
    "bullmq": "5.58.5",
    "ioredis": "5.7.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5"
  }
}
