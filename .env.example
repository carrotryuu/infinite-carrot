# Local development. Copy to .env and set NAS_ROOT to an EXISTING absolute directory.
NODE_ENV=development
MOCK_EXTERNAL=1
SERVER_PORT=3000
WEB_PORT=80
POSTGRES_DB=carrot
POSTGRES_USER=carrot
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://carrot:change-this-local-password@127.0.0.1:5432/carrot
REDIS_URL=redis://127.0.0.1:6379/0
NAS_ROOT=/absolute/path/to/infinite-carrot/.local/nas

# Server-only credentials. Mock mode never contacts model providers or Feishu.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_POC_PROVIDER=
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
# PoC is disabled unless explicitly enabled. Mock mode uses a fixed server-owned team.
POC_GATEWAY_ENABLED=0
POC_TEAM_ID=00000000-0000-4000-8000-000000000002
POC_TENANT_ID=
MODEL_CONCURRENCY=4
POC_QUEUE_NAMESPACE=poc-generation
MODEL_POLL_MS=1000
MODEL_TIMEOUT_MS=600000
MOCK_MIN_MS=10000
MOCK_MAX_MS=30000
MOCK_FAILURE_RATE=0
# Keep 0 until outbound access and real integration have been explicitly approved.
ALLOW_REAL_MODEL_CALLS=0
# Required for real-mode debug HTTP/Socket access; never a model API key.
POC_ACCESS_TOKEN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_REDIRECT_URI=
FEISHU_TENANT_KEY=
# Browser origin; dev uses :5173, Compose defaults to http://127.0.0.1.
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
AUTH_DEPLOY_ORIGIN=http://127.0.0.1
# Enable only after Feishu permissions and network access are confirmed. Real mode requires HTTPS.
ALLOW_REAL_FEISHU=0
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,server
# Optional E2E settings. Empty base URL starts local dev servers.
E2E_BASE_URL=
E2E_REQUIRE_HEALTHY=0
# Defaults to installed Chrome (H.264 support); set msedge to test Edge.
PLAYWRIGHT_CHANNEL=
