{
  "name": "infinite-carrot",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @carrot/shared build && concurrently -k -n shared,web,server,worker \"pnpm --filter @carrot/shared dev\" \"pnpm --filter @carrot/web dev\" \"pnpm --filter @carrot/server dev\" \"pnpm --filter @carrot/worker dev\"",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @carrot/shared build && pnpm -r typecheck && tsc --noEmit",
    "test": "pnpm --filter @carrot/shared build && vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @carrot/server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
